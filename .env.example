# Hote MySQL : host.docker.internal = MySQL installe sur le meme serveur (gerable via phpMyAdmin)
# Mets "db" ici si tu veux reutiliser le MySQL Docker (avec : docker compose --profile mysql-docker up -d)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=launcher_api
DB_PASSWORD=rootpassword_change_me
DB_NAME=Launcher
JWT_SECRET=change_moi_en_prod_min_32_caracteres_aleatoires_!!!!!

# Panel web admin (http://IP_SERVEUR:3001/panel/) - compte unique, aucun signup public
# Choisis un identifiant + mot de passe DEDIES au panel (differents du jeu).
# Le compte est cree automatiquement au demarrage de l'API s'il n'existe pas.
PANEL_ADMIN_USER=admin

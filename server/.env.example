# Copier vers .env : copy .env.example .env (Windows) / cp .env.example .env (Linux)
PORT=3000

# MySQL - en local dev
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword_change_me
DB_NAME=launcher_minecraft

# JWT - CHANGE OBLIGATOIRE EN PROD (32+ caractères aléatoires)
JWT_SECRET=change_moi_en_prod_min_32_caracteres_aleatoires
JWT_EXPIRES_IN=7d

# CORS - origine du launcher (Electron = pas de CORS strict, mais pour sécu web)
CORS_ORIGIN=*
